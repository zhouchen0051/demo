# ============================================
# Git 忽略文件配置
# ============================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
.venv/
.env/

# 环境变量（含 API Key，绝对不要提交！）
.env
.env.local
.env.*.local

# IDE 配置
.idea/
.vscode/
*.swp
*.swo

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/

# 构建产物
dist/
build/
*.egg-info/

# 日志
*.log
logs/
